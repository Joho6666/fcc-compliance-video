    {"scene": "timeline", "text": "（关键日期）", "title": "", "pose": "cheer", "sfx": "whoosh", "onscreen": {"nodes": [{"date": "", "label": ""}, {"date": "", "label": "", "now": true}, {"date": "", "label": ""}]}},
    {"scene": "timeline", "text": "你有时间。", "pose": "cheer", "sfx": "pop", "onscreen": {"chip": "你有时间"}},
    {"scene": "check", "text": "（引出清单）", "title": "", "pose": "point", "sfx": "whoosh", "onscreen": {"items": ["≤10字", "≤10字", "≤10字", "≤10字", "≤10字"]}},
    {"scene": "check", "text": "第一，……", "pose": "point", "sfx": "tick"},
    {"scene": "check", "text": "第二，……", "pose": "point", "sfx": "tick"},
