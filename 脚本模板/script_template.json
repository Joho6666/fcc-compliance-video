    {"scene": "chain", "text": "", "pose": "think", "sfx": "pop", "onscreen": {"chip": ""}},
    {"scene": "impact", "text": "（如果……）", "title": "", "pose": "surprised", "sfx": "whoosh", "onscreen": {"from": "", "via": "", "result": ""}},
