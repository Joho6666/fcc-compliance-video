    {"scene": "analogy", "text": "打个比方：（A），就像（B）。", "title": "打个【比方】", "pose": "none", "sfx": "whoosh", "onscreen": {"row": ["A图标/文字", "B图标/文字"]}},
    {"scene": "analogy", "text": "（C），就是（D）。", "pose": "none", "sfx": "pop", "onscreen": {"row": ["C", "D"]}},
    {"scene": "analogy", "text": "（类比得出的结论）", "pose": "none", "sfx": "pop", "onscreen": {"conclusion": ""}},
    {"scene": "chain", "text": "（问题出在哪）", "title": "", "pose": "think", "sfx": "whoosh", "onscreen": {"boxes": ["", "", ""]}},
